[Unit]
Description=margin.wiki nightly analyst: deterministic investigations over the collectors' own data (ROADMAP item 20, SEB-210/SEB-238)
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/margin
ExecStart=/usr/bin/python3 /srv/margin/tools/analyst.py
StandardOutput=append:/var/log/margin/analyst.systemd.log
StandardError=append:/var/log/margin/analyst.systemd.log

# Not an agent loop and not a model session -- analyst.py calls no model
# (SEB-301), it only reads the CSVs. It must still never compete for the box's CPU
# against margin-builder/margin-reviewer/margin-product, which carry no
# explicit weight and sit at the cgroup default (100). Same values as
# margin-p2p-box/margin-p2p-compare.
CPUWeight=20
IOWeight=10
MemoryMax=512M

# Unlike margin-p2p-box/margin-p2p-compare, which keep /srv/margin read-only
# and stage everything under /var/lib/margin instead, this script writes
# straight into the served checkout's data/ directory: analyst.py's own
# module docstring names data/analyst_findings.json and data/analyst_log.csv
# as its only outputs, and that is out of scope to change here (SEB-238).
# ProtectSystem stays "full" as it was when this unit also used the logged-in
# `claude` CLI; it no longer does.
ProtectSystem=full
ReadWritePaths=/srv/margin /var/log/margin
NoNewPrivileges=true
