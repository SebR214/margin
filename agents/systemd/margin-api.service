[Unit]
Description=margin.wiki read-only API (api.margin.wiki)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Served from its own checkout of main, never from an agent's working tree --
# an agent mid-build must never be able to change what the public API returns.
WorkingDirectory=/srv/margin
ExecStart=/usr/bin/python3 /srv/margin/tools/serve_api.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/margin/api.log
StandardError=append:/var/log/margin/api.log
ProtectSystem=strict
ReadOnlyPaths=/srv/margin
ReadWritePaths=/var/log/margin
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
