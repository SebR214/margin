[Unit]
Description=margin.wiki reviewer agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/margin
EnvironmentFile=/etc/margin/env
ExecStart=/srv/margin/agents/run.sh reviewer
Restart=always
RestartSec=30
StandardOutput=append:/var/log/margin/reviewer.systemd.log
StandardError=append:/var/log/margin/reviewer.systemd.log
# The agent edits this repository and nothing else on the box.
ProtectSystem=full
ReadWritePaths=/srv/margin /var/log/margin /etc/margin
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
