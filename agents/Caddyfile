# api.margin.wiki -- TLS is obtained and renewed automatically once the A record
# for `api` points at this box. Until then Caddy serves the site over HTTP and
# retries the certificate; nothing else has to change when DNS lands.

api.margin.wiki {
	encode gzip

	# /ask and /watch are served from margin.wiki and call this host from the
	# browser, so the API is open by CORS. Everything here reads data/
	# read-only; /watch also keeps its own subscriber state under
	# /var/log/margin, never in the git checkout -- see watch_backend.py.
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		-Server
	}
	@options method OPTIONS
	respond @options 204

	handle /mcp* {
		reverse_proxy 127.0.0.1:8900
	}
	handle /ask* {
		reverse_proxy 127.0.0.1:8901
	}
	handle /watch* {
		reverse_proxy 127.0.0.1:8902
	}
	handle {
		reverse_proxy 127.0.0.1:8899
	}

	# /var/log/caddy, not /var/log/margin: Caddy drops to its own unprivileged
	# user, which cannot write to the root-owned margin log directory, and it
	# refuses to start rather than logging nowhere.
	log {
		output file /var/log/caddy/api-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
